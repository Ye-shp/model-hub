# Copy to agents/.env on your laptop and fill in.
# Gateway address (the api. hostname from your Cloudflare Tunnel) ending in /v1.
HUB_URL=https://api.YOUR-DOMAIN/v1
# A key made with: node gateway/keys.js add laptop-agents   (add --frontier to allow Claude/GPT)
HUB_KEY=
# Optional: a frontier model the agents may consult, e.g. anthropic/claude-opus-5-5
# (must also be listed in ANTHROPIC_MODELS on the rental). Leave empty for Qwen only.
FRONTIER_MODEL=
# Path to adb.exe from Android platform-tools if it is not on PATH.
ADB=adb
# Only needed if more than one device is plugged in (see: adb devices).
PHONE_SERIAL=
