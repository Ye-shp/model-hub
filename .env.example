# Settings for the GPU rental. Paste these into the Vast template's environment variables.
# Never commit a filled-in copy. Generate each secret on your laptop with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ---- Required secrets ----
# Your master key for creating/revoking API keys (node gateway/keys.js).
ADMIN_KEY=
# Internal key between the gateway and the two model servers.
MODEL_API_KEY=
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel.
TUNNEL_TOKEN=

# ---- Website (Open WebUI) ----
WEBUI_URL=https://hub.YOUR-DOMAIN
# New sign-ins wait as "pending" until you approve them in Admin Panel > Users.
WEBUI_DEFAULT_ROLE=pending
# true lets the website use paid frontier models (still capped by FRONTIER_MONTHLY_CALLS).
WEBUI_FRONTIER=false

# ---- Resident models ----
# Requests each model works on at once; more share the same memory for context.
MODEL_PARALLEL=3
# Leave empty to use the largest context that fits in GPU memory (at least 32768 tokens).
# Measured: 134K tokens on a 3090, 262K on a V100 32GB. If a model keeps restarting
# with out-of-memory errors, set 65536.
MODEL_CONTEXT=
# Default thinking depth when a request doesn't specify one: low, medium or xhigh.
MODEL1_REASONING_EFFORT=medium
MODEL2_REASONING_EFFORT=low
# Max thinking tokens per answer (-1 = no limit). Lower = faster.
MODEL1_REASONING_BUDGET=-1
MODEL2_REASONING_BUDGET=-1
MAX_OUTPUT_TOKENS=32768

# ---- Third slot (separate GPU or service; optional) ----
MODEL3_URL=
# qwen-image-2.1 for the image box (docs/THIRD-MODEL.md), or a chat model's ID
MODEL3_ID=
# chat or image
MODEL3_KIND=chat
MODEL3_API_KEY=
# Default size for the website's image button (see docs/THIRD-MODEL.md for the list)
WEBUI_IMAGE_SIZE=1024x1024

# ---- Frontier providers (optional; comma-separated exact model IDs) ----
OPENAI_API_KEY=
OPENAI_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
OTHER_BASE_URL=
OTHER_API_KEY=
OTHER_MODELS=
# Shared monthly ceiling on frontier calls. Counts requests, not dollars.
FRONTIER_MONTHLY_CALLS=300

# ---- Limits ----
QUEUE_MAX=64
QUEUE_MAX_WAIT_MS=600000
# Streaming requests (the website, the agents) may run this long.
MODEL_TIMEOUT_MS=1800000
# Non-streaming requests include queue time and must finish before Cloudflare's 100 s limit.
NONSTREAM_TIMEOUT_MS=90000

# ---- Optional persistent owner workspace on the rental CPU ----
ENABLE_AGENT_CONSOLE=false
# Exact frontier gateway ID; leave blank to keep the controller key local-model-only.
AGENT_FRONTIER_MODEL=
CONSOLE_URL=
CONSOLE_KEY=

# ---- Agent team (controller + chat-site Pipe) ----
# Runs the agent controller on the CPU of the chat box and installs the "Hub ·" teams into the
# chat site on every start (the site's database is reset by a redeploy).
ENABLE_AGENT_CONSOLE=false
CONSOLE_KEY=
# Your Cloudflare Access email: the Pipe is installed as this account (the site's admin).
OWNER_EMAIL=
# Invited friends who may use the Hub teams (comma-separated). Admins always can.
PIPE_ALLOWED_EMAILS=
# Shared project for the Pipe (never "default", which holds your own work) and its speed profile.
PIPE_PROJECT=friends
PIPE_PROFILE=balanced

# ---- Qwen Cowork (the default model on the chat site; needs ENABLE_AGENT_CONSOLE=true) ----
# Type a goal; qwen-1 plans and does it with a sandboxed shell and files on this box, web search,
# helpers on qwen-2, images and project memory. Invited friends (PIPE_ALLOWED_EMAILS) get their own
# sandbox user and the "friends" project, without Claude/Codex.
# The chat site listens on a root-only Unix socket: the tunnel's ingress for it must be
# unix:/run/hub/webui.sock (WEBUI_TCP=true switches back to 127.0.0.1:3000 and makes the sandbox unsafe).
COWORK_PROFILE=balanced
COWORK_GUEST_PROFILE=balanced
# Hand-offs to Claude Code: run `claude setup-token` on any computer with your Claude plan and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# Hand-offs to Codex: send "/connect codex" in a Cowork chat (ChatGPT device sign-in), or set an API key.
CODEX_API_KEY=
# Hand-offs per 24 hours, and the longest one hand-off may run (seconds).
CLAUDE_DAILY_TASKS=30
CODEX_DAILY_TASKS=30
ESCALATION_TIMEOUT=1500
# Optional: Brave Search instead of the keyless DuckDuckGo/Bing search.
BRAVE_API_KEY=
# Tasks that run at once, and model calls in flight across them.
AGENT_SLOTS=4
AGENT_MODEL_CALLS=6
